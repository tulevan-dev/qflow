    int seq "suy ra từ UK order_id tier_id seq"
  }
  check_in_logs {
    uuid id PK
    uuid ticket_id FK
    uuid staff_id
    string result "OK DUPLICATE INVALID WRONG_EVENT"
    timestamp scanned_at
  }
  event_staff_replica {
    uuid event_id
    uuid staff_id
  }
  event_replica {
    uuid event_id PK
    timestamp starts_at
    timestamp ends_at
    string status
  }
