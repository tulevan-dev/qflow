erDiagram
  tickets ||--o{ check_in_logs : scanned
  tickets {
    uuid id PK
    uuid order_id
    uuid event_id
    uuid tier_id
    uuid owner_id
    string code UK
    string status "ISSUED CHECKED_IN VOID"
    timestamp issued_at
    timestamp checked_in_at
    uuid checked_in_by
