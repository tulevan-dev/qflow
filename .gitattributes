# Shell scripts: Linux-compatible line endings
*.sh text eol=lf

# Maven Wrapper
mvnw text eol=lf

# Windows batch scripts
*.bat text eol=crlf

# General text files
*.md text
*.yml text
*.yaml text
*.xml text
*.properties text
# Superpowers scripts kept executable across Windows and Unix checkouts
.agents/skills/superpowers/**/scripts/* text eol=lf
.agents/skills/superpowers/writing-skills/render-graphs.js text eol=lf
